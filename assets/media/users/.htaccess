# Las imágenes de perfil nunca se ejecutan como código
<IfModule mod_authz_core.c>
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
Require all denied
</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
Deny from all
</FilesMatch>
</IfModule>
<IfModule mod_php.c>
php_flag engine off
</IfModule>
